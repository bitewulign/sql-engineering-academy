# SQL Engineering Academy — Environment Variables
# Copy this file to .env and set your own values BEFORE running docker-compose
# NEVER commit .env to version control

# ── SQL Server ──────────────────────────────────────────
# Must meet SQL Server password policy:
# 8+ chars, upper, lower, digit, symbol
MSSQL_SA_PASSWORD=YourStrong@Password123

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=academy_user
POSTGRES_PASSWORD=YourPgPassword123

# ── MySQL ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=YourMySQLRoot123
MYSQL_USER=academy_user
MYSQL_PASSWORD=YourMySQLPassword123

# ── pgAdmin ─────────────────────────────────────────────
PGADMIN_EMAIL=admin@sqlacademy.local
PGADMIN_PASSWORD=YourPgAdminPassword123
